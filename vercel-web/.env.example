# Hominal CRM — Vercel-web environment example.
# Set these in Vercel → Project Settings → Environment Variables (Production + Preview).
# DO NOT commit real values.

# Supabase
SUPABASE_URL=https://hkyjxdmkqkydnrafhpgn.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://hkyjxdmkqkydnrafhpgn.supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# PostgREST fetch timeout (ms) for server-side Supabase client — prevents hung requests.
SUPABASE_FETCH_TIMEOUT_MS=20000

# OpenAI (server-only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Observability (optional — Phase 15)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Misc
API_AUDIT_DISABLED=false
