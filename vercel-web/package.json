{
  "name": "@hominal/web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e/smoke.spec.ts e2e/critical-flow.spec.ts",
    "test:e2e:ui": "playwright test e2e/ui-smoke.spec.ts",
    "test:e2e:mobile": "playwright test --project=mobile e2e/mobile-smoke.spec.ts",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@sentry/nextjs": "^9.47.1",
    "@supabase/supabase-js": "^2.49.8",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.18",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  }
}
