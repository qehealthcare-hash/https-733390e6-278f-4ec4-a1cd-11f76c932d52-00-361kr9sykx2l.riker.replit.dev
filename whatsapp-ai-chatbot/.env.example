PORT=3000
HOST=127.0.0.1

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-this-long-random-text
WHATSAPP_ACCESS_TOKEN=EAAB_your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APP_SECRET=your_meta_app_secret

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini

# Optional: comma-separated numbers allowed during testing, e.g. 919876543210,918888888888
ALLOWED_TEST_NUMBERS=
