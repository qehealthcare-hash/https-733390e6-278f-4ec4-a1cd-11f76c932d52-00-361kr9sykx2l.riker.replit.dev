# ──────────────────────────────────────────────────────────
# Maths Mania — environment template
# Copy to `.env.local` and fill in values. Never commit the real file.
# ──────────────────────────────────────────────────────────

# ── Site identity ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mathsmania.in
NEXT_PUBLIC_CHANNEL_URL=https://www.youtube.com/channel/UCbPBJROEaXpSryqgrcybufA
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mathsmaniaa/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61589172945959
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX

# ── YouTube Data API (milestone 4) ────────────────────────
YOUTUBE_CHANNEL_ID=UCbPBJROEaXpSryqgrcybufA
YOUTUBE_API_KEY=

# ── Per-pillar YouTube playlists (optional, for /courses/[slug]) ──
NEXT_PUBLIC_PLAYLIST_SCHOOL=
NEXT_PUBLIC_PLAYLIST_BANKING=
NEXT_PUBLIC_PLAYLIST_SSC=
NEXT_PUBLIC_PLAYLIST_TRICKS=

# ── Email (milestone 6, newsletter + transactional) ───────
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=hi@mathsmania.in

# ── Supabase (milestone 9 onwards — REQUIRED for Real-Time Exams) ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: salt for hashing IPs in newsletter/leads tables
# IP_HASH_SALT=

# ── Auth providers (milestone 10) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Redis (milestone 13 — exam attempt throttle, rate-limit) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Exam runtime (§14) ────────────────────────────────────
EXAM_DEFAULT_TIMEZONE=Asia/Kolkata
EXAM_HEARTBEAT_INTERVAL_SEC=15
EXAM_VIOLATION_THRESHOLD=3
MERIT_PUBLISH_DELAY_MIN=60
CERTIFICATE_TOP_PERCENT=10

# ── Cron auth (Vercel Cron — set in Production; auto-sent as Bearer) ─
CRON_SECRET=

# ── OTP hashing (optional — defaults to built-in salt) ────
# OTP_STORE_SALT=

# ── Load testing (m20 — local/staging only) ───────────────
# LOAD_TEST_EXAM_SLUG=ibps-quant-speed-test-2
# LOAD_TEST_PASSWORD=LoadTest123!

# ── Optional analytics ────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=mathsmania.in
