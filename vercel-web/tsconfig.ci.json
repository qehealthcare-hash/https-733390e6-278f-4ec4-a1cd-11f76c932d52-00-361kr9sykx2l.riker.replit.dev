{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "lib/**/*.ts",
    "app/api/**/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "app/**/*.tsx",
    "hooks/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/integration/**"
  ]
}
